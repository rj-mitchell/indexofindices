# Response headers for every file (Cloudflare Workers static assets read this file; it is not served).
# The same security headers as the charity's hub. The content security policy allows nothing from other
# sites: the fonts, the map, the figures and the scripts are all served from here.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Built files carry a hash of their contents in their names, so they never change: cache them for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable
